// Профиль станка (скелет, RON). Парсинг подключается в Ф2.
// Поля: рабочая зона, поворотная ось, лимиты, имя постпроцессора.
(
    name: "Generic 3-axis router",
    work_area: (
        x: (0.0, 600.0),
        y: (0.0, 400.0),
        z: (-100.0, 0.0),
    ),
    rotary: None,            // Some(( axis: "A", min: -360.0, max: 360.0 )) для 4-й оси
    max_rapid: 5000.0,      // мм/мин
    max_feed: 3000.0,       // мм/мин
    max_rpm: 24000.0,
    default_units: "mm",
    post: "mach3",
)
